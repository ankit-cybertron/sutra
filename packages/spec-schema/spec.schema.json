        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "step",
        "actor",
        "action",
        "outcome"
      ],

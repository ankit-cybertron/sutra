        "given": {
          "minLength": 1,
          "title": "Given",
          "type": "string"
        },
        "when": {
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "then": {
          "minLength": 1,
          "title": "Then",
          "type": "string"
        },
        "story": {
          "minLength": 1,
          "title": "Story",
          "type": "string"
        }

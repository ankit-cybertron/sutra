      "required": [
        "id",
        "given",
        "when",
        "then",
        "story"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,

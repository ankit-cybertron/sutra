# true  = run fully offline against src/api/mock.ts (default for `npm run dev`)
# false = talk to the FastAPI backend (same-origin via the Vite proxy, or VITE_API_BASE)
VITE_USE_MOCK=true

# Only set these if the API is on a different origin. Leave empty to use the dev proxy / same origin.
VITE_API_BASE=
# e.g. wss://api.example.com  (leave empty to derive ws(s):// from the page origin)
VITE_WS_BASE=

# Dev proxy target (read by vite.config.ts, not exposed to the browser)
# VITE_DEV_BACKEND=http://localhost:8000

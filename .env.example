# Sutra Backend Environment Configuration

# Brand Configuration
BRAND_NAME=Sutra
BRAND_TAGLINE="Say the idea. Skip the rambling."

# Environment & Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Groq LLM (Required)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Gnani AI (Prisma STT + Timbre TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_URL=https://api.vachana.ai
GNANI_STT_LANG=indic-auto
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_EN=Nalini
GNANI_MODE=live

# Storage
DATA_DIR=data
TTS_CACHE_DIR=data/tts-cache

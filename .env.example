# Copy to .env and fill in. NEVER commit .env. Placeholders only in this file.

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# Server-only. Never expose to the browser. Not used for user-scoped requests.
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- API ---
API_ENV=development            # development | production
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=INFO
RATE_LIMIT_ANALYZE_PER_MIN=6
RATE_LIMIT_COMPILE_PER_MIN=6
DAILY_LLM_BUDGET_TOKENS=300000
MAX_TRANSCRIPT_CHARS=12000

# --- LLM (choose one provider) ---
LLM_PROVIDER=fake              # fake | anthropic | openai | gemini
LLM_MODEL=replace-me
LLM_TIMEOUT_S=30
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- STT (optional) ---
STT_PROVIDER=none              # none | server
STT_API_KEY=

# --- Web (public values only; prefix NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
